<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane hgap="10.0" vgap="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="taskmanager.controller.TaskFormController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <columnConstraints>
      <ColumnConstraints halignment="RIGHT" minWidth="90.0" />
      <ColumnConstraints hgrow="ALWAYS" minWidth="280.0" prefWidth="340.0" />
   </columnConstraints>
   <children>
      <Label text="Название *" GridPane.rowIndex="0" />
      <TextField fx:id="titleField" promptText="Например: Подготовить отчёт" GridPane.columnIndex="1" GridPane.rowIndex="0" />

      <Label text="Описание" GridPane.rowIndex="1" GridPane.valignment="TOP" />
      <TextArea fx:id="descriptionArea" prefRowCount="4" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />

      <Label text="Приоритет" GridPane.rowIndex="2" />
      <ComboBox fx:id="priorityBox" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2" />

      <Label text="Срок" GridPane.rowIndex="3" />
      <DatePicker fx:id="dueDatePicker" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3" />

      <Label text="Статус" GridPane.rowIndex="4" />
      <ComboBox fx:id="statusBox" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="4" />

      <HBox alignment="CENTER_RIGHT" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="5">
         <children>
            <Button defaultButton="true" onAction="#onSave" text="Сохранить" />
            <Button cancelButton="true" onAction="#onCancel" text="Отмена" />
         </children>
      </HBox>
   </children>
</GridPane>
